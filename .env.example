# Copy this file to .env and fill in your values
# .env is gitignored — never commit real secrets

# Supabase — create a project at https://supabase.com
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Anthropic — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# iOS (optional overrides)
# IOS_BUNDLE_ID=com.forgefit.app
# IOS_BUILD_NUMBER=1

# Android (optional overrides)
# ANDROID_PACKAGE=com.thinkhale.forgefit
# ANDROID_VERSION_CODE=1
#
# NOTE: EAS cloud builds do not see this .env file (it's gitignored). Set
# SUPABASE_URL and SUPABASE_ANON_KEY as EAS env vars before building:
#   eas env:create --name SUPABASE_URL --value <url> --environment preview --environment production
#   eas env:create --name SUPABASE_ANON_KEY --value <key> --environment preview --environment production
